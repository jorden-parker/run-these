#!/bin/sh
subject_line="$(head -n 1 "$1")"
conventional_subject='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: [^ ]'
merge_subject='^Merge '

if printf '%s\n' "$subject_line" | grep -Eq "$conventional_subject|$merge_subject"; then
  exit 0
fi

cat >&2 <<REJECTION
Commit rejected: the first line must follow Conventional Commits.

  Yours:    $subject_line
  Format:   type(scope): summary
  Example:  feat(proxy): add the stream check
  Types:    feat fix docs style refactor perf test build ci chore revert
REJECTION
exit 1
