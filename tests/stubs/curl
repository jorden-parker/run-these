#!/bin/sh
call_number=$(($(cat "$CURL_CALLS/count" 2>/dev/null || echo 0) + 1))
echo "$call_number" > "$CURL_CALLS/count"
printf '%s\n' "$@" > "$CURL_CALLS/arguments-$call_number"
cat > "$CURL_CALLS/input-$call_number"
printf 'HTTP/1.1 429 Too Many Requests\r\n'
printf 'retry-after: 12\r\n'
printf 'anthropic-ratelimit-requests-remaining: 0\r\n'
printf 'set-cookie: session=internal\r\n'
printf 'x-internal-host: gateway.internal\r\n'
printf '\r\n'
printf '{"type":"error","error":{"type":"rate_limit_error","message":"slow down"}}'
